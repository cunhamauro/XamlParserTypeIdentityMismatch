<Window x:Class="AddinA.SampleWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:sample="http://schemas.local/xaml-parser-type-identity"
        Title="AddinA Sample Window"
        Height="240"
        Width="480">
    <Window.Resources>
        <DataTemplate DataType="{x:Type sample:ViewModel}">
            <sample:UserControl />
        </DataTemplate>
    </Window.Resources>
    <Grid>
        <ContentControl x:Name="ContentHost" />
    </Grid>
</Window>
